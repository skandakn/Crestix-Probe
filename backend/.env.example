# Crestix Probe Backend Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# Do NOT commit real secrets or production credentials to version control.

# Application Settings
APP_NAME="Crestix Probe API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_PREFIX="/api"

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL="postgresql+psycopg2://postgres:password_placeholder@localhost:5432/crestix_probe"

# Security & Authentication Integration
AUTH_SECRET_KEY="replace_with_a_secure_random_secret_placeholder"
AUTH_API_KEY="replace_with_service_or_device_api_key_placeholder"
AUTH_ENABLED=false

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://crestix-probe.example.com"

# Storage & File Upload Settings
UPLOAD_DIR="./uploads/terrain"
MAX_UPLOAD_SIZE_MB=50

# Sensor Calibration Defaults
DEFAULT_MOUNT_HEIGHT_CM=20.0
MAX_SENSOR_DISTANCE_CM=400.0
MIN_SENSOR_DISTANCE_CM=1.0

# Research Engines Integration Status (honest capabilities declaration)
SIMULATION_ADAPTER_MODE="stub"
FORECAST_ADAPTER_MODE="stub"
